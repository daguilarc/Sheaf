#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PLUGIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
ENTRYPOINT="${PLUGIN_DIR}/assets/xagent/dist/src/main.js"

# The packaged launcher ships to every machine, so it cannot bake in one
# person's checkout path. It must also agree with the SERVICE's log root, not
# the caller's: the service resolves its root once at startup
# (src/service/config.ts findSheafRoot), so a caller sitting in a worktree
# must not resolve to the worktree's own data/ — a Sheaf worktree carries
# config/services.json and structure/ too, and picking it would make
# `xagent list` report an empty log root while the service writes elsewhere.
# Ask git for the common dir, which points at the main checkout from inside
# any linked worktree.
#
find_sheaf_root() {
  local dir="${1}"
  while [ "${dir}" != "/" ]; do
    if [ -f "${dir}/config/services.json" ] && [ -d "${dir}/structure" ]; then
      printf '%s\n' "${dir}"
      return 0
    fi
    dir="$(dirname "${dir}")"
  done
  return 1
}

main_checkout_root() {
  local common_dir primary
  if ! command -v git >/dev/null 2>&1; then
    return 1
  fi
  common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ -n "${common_dir}" ] || return 1
  primary="$(dirname "${common_dir}")"
  if [ -f "${primary}/config/services.json" ] && [ -d "${primary}/structure" ]; then
    printf '%s\n' "${primary}"
    return 0
  fi
  return 1
}

default_log_root() {
  local sheaf_root
  if sheaf_root="$(main_checkout_root)"; then
    printf '%s\n' "${sheaf_root}/data/xagent"
    return 0
  fi
  if sheaf_root="$(find_sheaf_root "$(pwd -P)")"; then
    printf '%s\n' "${sheaf_root}/data/xagent"
    return 0
  fi
  printf '%s\n' "${HOME}/.xagent/data"
}

export XAGENT_LOG_ROOT="${XAGENT_LOG_ROOT:-${SHEAF_XAGENT_LOG_ROOT:-$(default_log_root)}}"

if ! command -v node >/dev/null 2>&1; then
  echo "xagent plugin requires Node.js >=20, but node is not on PATH." >&2
  exit 127
fi

NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])')"
if [ "${NODE_MAJOR}" -lt 20 ]; then
  echo "xagent plugin requires Node.js >=20, found $(node --version)." >&2
  exit 1
fi

if [ ! -f "${ENTRYPOINT}" ]; then
  echo "xagent packaged runtime is missing: ${ENTRYPOINT}" >&2
  echo "Run make xagent-plugin-build from the Sheaf repository to rebuild plugin assets." >&2
  exit 1
fi

exec node "${ENTRYPOINT}" "$@"
