#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_dir="$repo_root/projects/quest-runner"
python="$project_dir/.venv/bin/python"

if [[ ! -x "$python" ]]; then
  echo "Missing quest-runner virtualenv at $python" >&2
  echo "Run: make -C projects/quest-runner test" >&2
  exit 1
fi

exec "$python" "$project_dir/bin/quest-runner" "$@"
