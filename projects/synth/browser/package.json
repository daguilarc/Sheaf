{
  "name": "sheaf-synth-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile:browser-apps": "node dist/src/build-browser-apps.mjs",
    "compile:browser-fixture": "node dist/src/build-browser-apps.mjs --manifest tests/fixtures/fake-browser-apps.json --allowed-source-root tests/fixtures/cpp --output-root dist/wasm/fixture-apps",
    "build:cloudflare-pages": "bash scripts/cloudflare-pages-build.sh",
    "package:app": "node dist/src/package-app.mjs",
    "publish:site": "npm run build && node dist/src/publish-site.mjs",
    "publish:pages": "node dist/src/publish-site.mjs --publisher-only",
    "test": "npm run build && npm run check:generic-runtime && node --test dist/tests/*.test.mjs && make browser-fixture-app && playwright test",
    "check:generic-runtime": "node tests/check-generic-runtime.mjs",
    "test:unit": "npm run build && node --test dist/tests/*.test.mjs",
    "test:package": "npm run build && node --test dist/tests/package-contract.test.mjs && playwright test tests/package-loader.spec.ts tests/two-origin-package.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.8.3",
    "yaml": "2.8.1"
  }
}
