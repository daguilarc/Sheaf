{
  "name": "sheaf-unstaged-hunk-pane",
  "displayName": "Sheaf Unstaged Hunk Pane",
  "description": "Custom peek-like unstaged hunk pane with Dictator Launchpad integration.",
  "version": "0.0.1",
  "publisher": "sheaf",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sheaf.hunks.previousHunk",
    "onCommand:sheaf.hunks.nextHunk",
    "onCommand:sheaf.hunks.previousFile",
    "onCommand:sheaf.hunks.nextFile",
    "onCommand:sheaf.hunks.getCurrentHunk",
    "onCommand:sheaf.hunks.stageCurrentHunk",
    "onCommand:sheaf.hunks.revertCurrentHunk",
    "onCommand:sheaf.hunks.undo"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "sheaf.hunks.previousHunk",
        "title": "Sheaf Hunks: Previous Hunk"
      },
      {
        "command": "sheaf.hunks.nextHunk",
        "title": "Sheaf Hunks: Next Hunk"
      },
      {
        "command": "sheaf.hunks.previousFile",
        "title": "Sheaf Hunks: Previous File"
      },
      {
        "command": "sheaf.hunks.nextFile",
        "title": "Sheaf Hunks: Next File"
      },
      {
        "command": "sheaf.hunks.getCurrentHunk",
        "title": "Sheaf Hunks: Get Current Hunk"
      },
      {
        "command": "sheaf.hunks.stageCurrentHunk",
        "title": "Sheaf Hunks: Stage Current Hunk"
      },
      {
        "command": "sheaf.hunks.revertCurrentHunk",
        "title": "Sheaf Hunks: Revert Current Hunk"
      },
      {
        "command": "sheaf.hunks.undo",
        "title": "Sheaf Hunks: Undo Stage/Revert"
      }
    ],
    "configuration": {
      "title": "Sheaf Unstaged Hunk Pane",
      "properties": {
        "sheaf.hunks.dictatorBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9003",
          "description": "Base URL for the Dictator control server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "clean": "rm -rf out .test-dist node_modules *.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
