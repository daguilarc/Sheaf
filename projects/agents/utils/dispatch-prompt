#!/usr/bin/env python3
"""Render a Superpowers subagent prompt template to a file and print its path.

The Superpowers templates (implementer, task-reviewer, re-review, code-reviewer)
document a prompt a controller is expected to fill in and emit as a message.
Controllers under context pressure compress that prose, dropping the review
rubric while keeping the scaffolding. This renders the template to a file
instead, so the controller dispatches by path and never retypes the body.

Usage:
  dispatch-prompt <template> --plan PLAN [options]

See --help for the per-template option set.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path


# Superpowers can be installed from more than one marketplace. Sheaf's own
# vendored install lands under `sheaf-managed`; the upstream marketplace
# install lands under `claude-plugins-official`. Search both, managed first,
# because pinning one root silently broke every SDD dispatch the moment the
# vendored install replaced the upstream copy.
PLUGIN_ROOTS = (
    Path.home() / ".claude/plugins/cache/sheaf-managed/superpowers",
    Path.home() / ".claude/plugins/cache/claude-plugins-official/superpowers",
)
TEMPLATES_ROOT_ENV = "SUPERPOWERS_TEMPLATES_ROOT"

# Substitution kinds:
#   path     - value is a filesystem path; must exist and be non-empty; the
#              PATH is substituted
#   path_out - value is a filesystem path the subagent will WRITE; only its
#              parent must exist; the PATH is substituted
#   filetext - value is a filesystem path; must exist; its CONTENTS are
#              substituted
#   text     - value is inline text, or @FILE to read the text from a file
#   literal  - value is a plain string substituted as-is
#
# Every declared slot must end up substituted. `required` means the caller must
# supply it; a non-required slot must still be satisfied by a derivation or by
# `fallback`, because a surviving "[TOKEN]" in a delivered prompt is noise the
# subagent has to interpret.

# Direction is declared only for slots whose value is a caller-supplied
# filesystem path. `text` and `literal` carry inline values, so they have no
# direction and requiring one would force an invented semantic (dpr-5).
DIRECTIONS: dict[str, str | None] = {
    "path": "reads",
    "filetext": "reads",
    "path_out": "writes",
    "text": None,
    "literal": None,
}


@dataclass(frozen=True)
class Slot:
    token: str
    option: str
    kind: str
    required: bool = False
    fallback: str | None = None
    # The conventional plan-workspace filename `_supplied` can satisfy this
    # slot with when the caller omits it. A fallback-less slot with a
    # derivation is renderable without the caller supplying anything, so
    # fallback absence alone does not mean "the caller must provide this".
    derivation: dict | None = None

    @property
    def direction(self) -> str | None:
        return DIRECTIONS[self.kind]


@dataclass(frozen=True)
class Template:
    skill: str
    filename: str
    slots: tuple[Slot, ...]
    task_scoped: bool = True
    rounds: bool = False
    # Body carries the literal "Task N" in prose rather than a bracket token.
    task_token: bool = False
    # Template takes --base/--head, so the review package path can be derived.
    wants_shas: bool = False


def workspace_derivation(pattern: str, *, requires_existing: bool = True) -> dict:
    """A file `_supplied` looks for in the plan's SDD workspace (dpr-11).

    `{task}` is the task number; `{short(base)}` and `{short(head)}` are
    `git rev-parse --short` of those revisions, falling back to the first
    seven characters — see `short_sha`.
    """
    return {"kind": "plan_workspace", "pattern": pattern,
            "requires_existing": requires_existing}


REPO_ROOT_DERIVATION = {"kind": "repo_root"}
REVIEW_DIFF_PATTERN = "review-{short(base)}..{short(head)}.diff"


TEMPLATES: dict[str, Template] = {
    "implementer": Template(
        skill="subagent-driven-development",
        filename="implementer-prompt.md",
        slots=(
            Slot("[task name]", "--name", "literal", required=True),
            Slot("[BRIEF_FILE]", "--brief", "path", required=True),
            Slot(
                "[Scene-setting: where this fits, dependencies, architectural context]",
                "--context",
                "text",
                fallback="No additional context beyond the task brief.",
            ),
            Slot("[directory]", "--dir", "literal", derivation=REPO_ROOT_DERIVATION),
            # The implementer WRITES its report, so this path need not exist yet.
            Slot(
                "[REPORT_FILE]",
                "--report",
                "path_out",
                derivation=workspace_derivation(
                    "task-{task}-report.md", requires_existing=False
                ),
            ),
        ),
        task_token=True,
    ),
    "task-reviewer": Template(
        skill="subagent-driven-development",
        filename="task-reviewer-prompt.md",
        slots=(
            Slot("[BRIEF_FILE]", "--brief", "path", required=True),
            Slot(
                "[GLOBAL_CONSTRAINTS]",
                "--constraints",
                "filetext",
                fallback="None beyond the task brief.",
                derivation=workspace_derivation("global-constraints.md"),
            ),
            Slot(
                "[REPORT_FILE]",
                "--report",
                "path",
                derivation=workspace_derivation("task-{task}-report.md"),
            ),
            Slot("[BASE_SHA]", "--base", "literal", required=True),
            Slot("[HEAD_SHA]", "--head", "literal", required=True),
            Slot(
                "[DIFF_FILE]",
                "--diff",
                "path",
                derivation=workspace_derivation(REVIEW_DIFF_PATTERN),
            ),
        ),
        wants_shas=True,
    ),
    "re-review": Template(
        skill="subagent-driven-development",
        filename="re-review-prompt.md",
        slots=(
            Slot("[BRIEF_FILE]", "--brief", "path", required=True),
            Slot("[FINDINGS]", "--findings", "filetext", required=True),
            Slot(
                "[REPORT_FILE]",
                "--report",
                "path",
                derivation=workspace_derivation("task-{task}-report.md"),
            ),
            Slot("[FIX_BASE_SHA]", "--base", "literal", required=True),
            Slot("[HEAD_SHA]", "--head", "literal", required=True),
            Slot(
                "[DIFF_FILE]",
                "--diff",
                "path",
                derivation=workspace_derivation(REVIEW_DIFF_PATTERN),
            ),
        ),
        rounds=True,
        wants_shas=True,
    ),
    "code-reviewer": Template(
        skill="requesting-code-review",
        filename="code-reviewer.md",
        slots=(
            Slot("[DESCRIPTION]", "--description", "text", required=True),
            Slot("[PLAN_OR_REQUIREMENTS]", "--requirements", "text", required=True),
            Slot("[BASE_SHA]", "--base", "literal", required=True),
            Slot("[HEAD_SHA]", "--head", "literal", required=True),
        ),
        task_scoped=False,
    ),
}

# Templates whose body carries "Task N" in prose rather than a bracket token.
TASK_NUMBER_TOKEN = "Task N"

# Options that are never template slots.
GLOBAL_OPTIONS = {"--plan", "--out", "--templates-root"}

# Every option that is a slot on at least one template.
SLOT_OPTIONS = {slot.option for template in TEMPLATES.values() for slot in template.slots}


class Fail(Exception):
    """A user-facing failure. Nothing is written when this is raised."""

    def __init__(self, message: str, *, error: str | None = None,
                 option: str | None = None, path: str | None = None,
                 template: str | None = None) -> None:
        super().__init__(message)
        # Only enumerated argument faults carry a code; template-resolution
        # and drift failures deliberately do not, so an embedder classifying
        # by trailer treats them as unrecognized (dpr-10).
        self.error = error
        self.option = option
        self.path = path
        self.template = template

    def trailer(self) -> str | None:
        if self.error is None:
            return None
        body: dict[str, str] = {"error": self.error, "option": self.option or ""}
        if self.path is not None:
            body["path"] = self.path
        if self.template is not None:
            body["template"] = self.template
        return json.dumps(body, sort_keys=True)


# ---------------------------------------------------------------- resolution


def parse_version(name: str) -> tuple[int, ...] | None:
    if not re.fullmatch(r"\d+(\.\d+)*", name):
        return None
    return tuple(int(part) for part in name.split("."))


def installed_versions(root: Path) -> list[Path]:
    """Version directories under `root`, highest first, ordered numerically."""
    if not root.is_dir():
        return []
    found = [
        (version, entry)
        for entry in root.iterdir()
        if entry.is_dir() and (version := parse_version(entry.name)) is not None
    ]
    return [entry for _, entry in sorted(found, key=lambda pair: pair[0], reverse=True)]


def resolve_template_file(template: Template, explicit: str | None) -> Path:
    """Locate the template file, preferring the highest version that HAS it."""
    relative = Path(template.skill) / template.filename
    searched: list[Path] = []

    for candidate in (explicit, os.environ.get(TEMPLATES_ROOT_ENV)):
        if candidate:
            root = Path(candidate).expanduser()
            if not root.is_dir():
                raise Fail(f"templates root does not exist: {root}")
            source = root / relative
            if source.is_file():
                return source
            raise Fail(f"template file not found: {source}")

    # Fall through versions rather than stopping at the highest: a version that
    # ships a skills/ tree without this template must not mask an older one
    # that has it.
    for plugin_root in PLUGIN_ROOTS:
        for entry in installed_versions(plugin_root):
            source = entry / "skills" / relative
            searched.append(source)
            if source.is_file():
                return source

    for plugin_root in PLUGIN_ROOTS:
        searched.append(plugin_root / "<version>" / "skills" / relative)
    raise Fail(
        "could not resolve a Superpowers template. Searched:\n  "
        + "\n  ".join(str(path) for path in searched)
        + f"\nPass --templates-root or set {TEMPLATES_ROOT_ENV}."
    )


def repo_root() -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        raise Fail("not inside a git repository; cannot resolve the plan workspace") from exc
    return Path(out.stdout.strip())


def plan_workspace(plan: Path) -> Path:
    """Mirror sdd-workspace: <repo-root>/.superpowers/sdd/<plan-basename>/."""
    if not plan.is_file():
        raise Fail(
            f"no such plan file: {plan}",
            error="no_such_file",
            option="--plan",
            path=str(plan),
        )
    slug = plan.name[:-3] if plan.name.endswith(".md") else plan.name
    if not slug or slug in {".", ".."}:
        raise Fail(f"cannot derive a workspace name from: {plan}")
    base = repo_root() / ".superpowers" / "sdd"
    workspace = base / slug
    workspace.mkdir(parents=True, exist_ok=True)
    (base / ".gitignore").write_text("*\n", encoding="utf-8")
    return workspace


def short_sha(rev: str) -> str:
    out = subprocess.run(
        ["git", "rev-parse", "--short", rev], capture_output=True, text=True
    )
    return out.stdout.strip() if out.returncode == 0 else rev[:7]


# ---------------------------------------------------------------- extraction


def extract_prompt_body(text: str, source: Path) -> str:
    """Return the dedented `prompt: |` body of the template's dispatch block.

    The outer fence opens at column 0; fences inside the prompt body are
    indented with the body (code-reviewer.md carries an indented ```bash
    block), so a column-0 fence is an unambiguous delimiter.
    """
    lines = text.splitlines()
    fences = [i for i, line in enumerate(lines) if line.startswith("```")]
    if len(fences) < 2:
        raise Fail(f"no column-0 fenced dispatch block in template: {source}")
    start, end = fences[0], fences[1]

    body_start = None
    for i in range(start + 1, end):
        if re.fullmatch(r"\s*prompt:\s*\|\s*", lines[i]):
            body_start = i + 1
            break
    if body_start is None:
        raise Fail(f"no `prompt: |` line in the dispatch block of: {source}")

    body = lines[body_start:end]
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    if not body:
        raise Fail(f"empty prompt body in template: {source}")

    indents = [
        len(line) - len(line.lstrip()) for line in body if line.strip()
    ]
    margin = min(indents) if indents else 0
    return "\n".join(line[margin:] if line.strip() else "" for line in body) + "\n"


# ---------------------------------------------------------------- rendering


def read_file(path_str: str, option: str) -> tuple[Path, str]:
    path = Path(path_str).expanduser()
    if not path.is_file():
        raise Fail(f"{option}: no such file: {path}",
                   error="no_such_file", option=option, path=path_str)
    content = path.read_text(encoding="utf-8")
    if not content.strip():
        raise Fail(f"{option}: file is empty: {path}",
                   error="empty_file", option=option, path=path_str)
    return path, content


def slot_value(slot: Slot, raw: str) -> str:
    if slot.kind == "path":
        path, _ = read_file(raw, slot.option)
        return str(path.resolve())
    if slot.kind == "path_out":
        path = Path(raw).expanduser()
        if not path.parent.is_dir():
            raise Fail(
                f"{slot.option}: parent directory does not exist: {path.parent}",
                error="parent_missing",
                option=slot.option,
                path=raw,
            )
        return str(path.resolve())
    if slot.kind == "filetext":
        _, content = read_file(raw, slot.option)
        return content.rstrip("\n")
    if slot.kind == "text":
        if raw.startswith("@"):
            _, content = read_file(raw[1:], slot.option)
            return content.rstrip("\n")
        return raw
    return raw


def token_pattern(token: str) -> str:
    # "Task N" is prose, not a bracketed token, so anchor it on word boundaries
    # to leave text like "Task Name" alone.
    return r"\bTask N\b" if token == TASK_NUMBER_TOKEN else re.escape(token)


def substitute_once(body: str, values: dict[str, str]) -> tuple[str, int]:
    """Replace every token in one pass; return (result, replacement count).

    Sequential str.replace would rescan already-substituted text, so a value
    that happens to contain another token — a findings file quoting
    "[DIFF_FILE]", say — would be corrupted by a later replacement.
    """
    if not values:
        return body, 0
    tokens = sorted(values, key=len, reverse=True)
    pattern = "|".join(token_pattern(token) for token in tokens)
    # Every alternative matches its key exactly, including the anchored
    # "Task N", so the matched text is always a valid lookup.
    return re.subn(pattern, lambda match: values[match.group(0)], body)


def render(template: Template, name: str, args: argparse.Namespace) -> tuple[str, Path]:
    source = resolve_template_file(template, args.templates_root)
    body = extract_prompt_body(source.read_text(encoding="utf-8"), source)

    # Drift check before substituting: a renamed or removed upstream token must
    # fail loudly, not silently drop the content it was carrying.
    missing = [slot.token for slot in template.slots if slot.token not in body]
    if template.task_token and TASK_NUMBER_TOKEN not in body:
        missing.append(TASK_NUMBER_TOKEN)
    if missing:
        raise Fail(
            f"template drift: {name} ({source}) no longer contains "
            + ", ".join(repr(token) for token in missing)
            + "\nUpdate the manifest in this script, or pin with --templates-root."
        )

    plan = Path(args.plan).expanduser()
    workspace = plan_workspace(plan)

    supplied = _supplied(template, args, workspace)

    values: dict[str, str] = {}
    for slot in template.slots:
        raw = supplied.get(slot.option)
        if raw is None:
            if slot.fallback is None:
                detail = (
                    " — supply an existing, non-empty file path"
                    if slot.kind in {"path", "filetext"}
                    else ""
                )
                raise Fail(
                    f"{slot.option} is required for the {name} template{detail} "
                    "(no value supplied and none could be derived)",
                    error="required_missing",
                    option=slot.option,
                    template=name,
                )
            values[slot.token] = slot.fallback
            continue
        values[slot.token] = slot_value(slot, raw)

    if template.task_token:
        values[TASK_NUMBER_TOKEN] = f"Task {args.task}"

    # Count what should be replaced before touching the body. Checking for
    # surviving tokens afterwards would false-positive on a substituted value
    # that legitimately quotes a token.
    expected = sum(len(re.findall(token_pattern(token), body)) for token in values)
    body, replaced = substitute_once(body, values)
    if replaced != expected:
        raise Fail(
            f"internal error: substituted {replaced} of {expected} expected "
            "placeholder occurrences"
        )

    return body, workspace / output_name(template, name, args)


def _supplied(
    template: Template, args: argparse.Namespace, workspace: Path
) -> dict[str, str]:
    """Explicit options, plus conventional derivations. --brief is never derived."""
    supplied: dict[str, str] = {}
    options = {slot.option for slot in template.slots}

    for slot in template.slots:
        attr = slot.option.lstrip("-").replace("-", "_")
        value = getattr(args, attr, None)
        if value is not None:
            supplied[slot.option] = value

    kinds = {slot.option: slot.kind for slot in template.slots}

    if template.task_scoped and "--report" in options and "--report" not in supplied:
        candidate = workspace / f"task-{args.task}-report.md"
        # An implementer writes its report, so derive the path unconditionally;
        # a reviewer reads one, so only derive a report that actually exists —
        # otherwise fail and make the caller say which report to review.
        if kinds["--report"] == "path_out" or candidate.is_file():
            supplied["--report"] = str(candidate)

    if template.task_scoped and "--constraints" in options and "--constraints" not in supplied:
        candidate = workspace / "global-constraints.md"
        if candidate.is_file():
            supplied["--constraints"] = str(candidate)

    if template.wants_shas and "--diff" in options and "--diff" not in supplied:
        candidate = workspace / f"review-{short_sha(args.base)}..{short_sha(args.head)}.diff"
        if candidate.is_file():
            supplied["--diff"] = str(candidate)

    if "--dir" in options and "--dir" not in supplied:
        supplied["--dir"] = str(repo_root())

    return supplied


def output_name(template: Template, name: str, args: argparse.Namespace) -> str:
    if not template.task_scoped:
        return f"dispatch-{name}.md"
    if template.rounds:
        return f"dispatch-{name}-task-{args.task}-round-{args.round}.md"
    return f"dispatch-{name}-task-{args.task}.md"


def write_atomic(path: Path, content: str) -> None:
    handle, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".dispatch-", suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(content)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# ---------------------------------------------------------------------- main


DESCRIBE_SCHEMA_VERSION = 1


def describe_slots() -> str:
    """A machine-readable slot table so embedders describe, never restate (dpr-11)."""
    return json.dumps(
        {
            "schema_version": DESCRIBE_SCHEMA_VERSION,
            "templates": {
                name: [
                    {
                        "option": slot.option,
                        "token": slot.token,
                        "kind": slot.kind,
                        "direction": slot.direction,
                        "has_fallback": slot.fallback is not None,
                        "derivation": slot.derivation,
                    }
                    for slot in template.slots
                ]
                for name, template in TEMPLATES.items()
            },
        },
        indent=2,
        sort_keys=True,
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="dispatch-prompt",
        description="Render a Superpowers subagent prompt template to a file.",
    )
    parser.add_argument("template", nargs="?", choices=sorted(TEMPLATES), help="template role name")
    parser.add_argument("--plan", required=False, help="implementation plan file")
    parser.add_argument("--task", help="task number (task-scoped templates)")
    parser.add_argument("--round", help="fix round number (re-review)")
    parser.add_argument("--name", help="task name (implementer)")
    parser.add_argument("--brief", help="task or review brief FILE — must exist, substituted as a path")
    parser.add_argument("--report", help="implementer/fixer report FILE to READ (task-reviewer, re-review); WRITE destination (implementer)")
    parser.add_argument("--constraints", help="global constraints file (contents inlined); defaults to the workspace file")
    parser.add_argument("--findings", help="findings file (contents inlined)")
    parser.add_argument("--context", help="scene-setting text, or @FILE")
    parser.add_argument("--description", help="what was built, or @FILE")
    parser.add_argument("--requirements", help="plan or requirements text, or @FILE")
    parser.add_argument("--dir", help="working directory for the subagent")
    parser.add_argument("--base", help="base commit")
    parser.add_argument("--head", help="head commit")
    parser.add_argument("--diff", help="review package diff FILE — required for task-reviewer and re-review unless derivable")
    parser.add_argument("--out", help="explicit output path")
    parser.add_argument("--templates-root", help="override the Superpowers skills root")
    parser.add_argument("--describe-slots", action="store_true",
                        help="print the machine-readable slot table and exit")
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)

    if args.describe_slots:
        print(describe_slots())
        return 0

    try:
        if args.template is None:
            raise Fail(
                "a template name is required",
                error="required_missing",
                option="template",
            )
        if args.plan is None:
            raise Fail(
                "--plan is required",
                error="required_missing",
                option="--plan",
                template=args.template,
            )

        template = TEMPLATES[args.template]

        if template.task_scoped and args.task is None:
            raise Fail(
                f"--task is required for the {args.template} template",
                error="required_missing",
                option="--task",
                template=args.template,
            )
        if template.rounds and args.round is None:
            raise Fail(
                f"--round is required for the {args.template} template",
                error="required_missing",
                option="--round",
                template=args.template,
            )

        # Reject options this template has no slot for. Silently ignoring them
        # would let a caller believe it passed a brief or findings that never
        # reached the rendered prompt.
        allowed = {slot.option for slot in template.slots} | GLOBAL_OPTIONS
        if template.task_scoped:
            allowed.add("--task")
        if template.rounds:
            allowed.add("--round")
        for option in sorted(SLOT_OPTIONS | {"--task", "--round"}):
            attr = option.lstrip("-").replace("-", "_")
            if getattr(args, attr, None) is not None and option not in allowed:
                raise Fail(
                    f"{option} is not accepted by the {args.template} template "
                    "(it has no matching placeholder)",
                    error="not_accepted",
                    option=option,
                    template=args.template,
                )

        body, default_out = render(template, args.template, args)
        out = Path(args.out).expanduser() if args.out else default_out
        out.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(out, body)
    except Fail as exc:
        print(f"dispatch-prompt: {exc}", file=sys.stderr)
        trailer = exc.trailer()
        if trailer is not None:
            print(trailer, file=sys.stderr)
        return 2

    print(out.resolve())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
