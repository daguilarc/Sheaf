# Shared settings for the Sheaf Tart-based agent VM toolkit.

TART=${TART:-/opt/homebrew/bin/tart}
SSHPASS=${SSHPASS:-/opt/homebrew/bin/sshpass}

# Sequoia keeps the guest major version aligned with this macOS 15 host.
BASE_IMAGE=${BASE_IMAGE:-ghcr.io/cirruslabs/macos-sequoia-base:latest}
GOLDEN_VM=${GOLDEN_VM:-agent-macos-golden}

AGENT_VM_PREFIX=${AGENT_VM_PREFIX:-agent}
AGENT_VM_LOG_DIR=${AGENT_VM_LOG_DIR:-$TOOLKIT_DIR/logs}

VM_CPU=${VM_CPU:-4}
VM_MEMORY_MB=${VM_MEMORY_MB:-8192}
VM_DISK_GB=${VM_DISK_GB:-100}
VM_DISPLAY=${VM_DISPLAY:-1440x900}

SSH_USER=${SSH_USER:-admin}
SSH_PASSWORD=${SSH_PASSWORD:-admin}
